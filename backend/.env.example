DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
APP_ENV=development
AUTH_SECRET_KEY=change-me-in-local-env
INIT_DB_ENABLED=false

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_ACTIVITY_FOLDER=havaya-im-neshama/activities
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe

# External route calculation (OpenRouteService)
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key
BUSINESS_BASE_ADDRESS="לנדרס 16, רמת גן, ישראל"
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
OPENROUTESERVICE_TIMEOUT_SECONDS=15
OPENROUTESERVICE_COUNTRY_CODE=ISR
